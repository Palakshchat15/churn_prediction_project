      <column caption='Block Rate' datatype='real' name='[BlockRate]' role='measure' type='quantitative' />
      <column caption='Blocked Calls' datatype='real' name='[BlockedCalls]' role='measure' type='quantitative' />
      <column caption='Buys Via Mail Order' datatype='integer' name='[BuysViaMailOrder]' role='measure' type='quantitative' />
      <column caption='Number of Records' datatype='integer' name='[Calculation_0395596540063744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Churn Rate %' datatype='real' name='[Calculation_0395596541304834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Churn])' />
      </column>
      <column caption='Churn Label' datatype='string' name='[Calculation_0395596541378563]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Churn] = 1 THEN &quot;Churned&quot; ELSE &quot;Retained&quot; END' />
      </column>
      <column caption='Tenure Label' datatype='string' name='[Calculation_0395596541448196]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [TenureBucket] = 0 THEN &quot;0 - New (0-12m)&quot;&#13;&#10;ELSEIF [TenureBucket] = 1 THEN &quot;1 - Growing (12-24m)&quot;&#13;&#10;ELSEIF [TenureBucket] = 2 THEN &quot;2 - Established (24-48m)&quot;&#13;&#10;ELSE &quot;3 - Loyal (48m+)&quot;&#13;&#10;END' />
      </column>
      <column caption='Credit Rating Label' datatype='string' name='[Calculation_0395596541521925]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CreditRating] = 1 THEN &quot;1 - Highest&quot;&#13;&#10;ELSEIF [CreditRating] = 2 THEN &quot;2 - High&quot;&#13;&#10;ELSEIF [CreditRating] = 3 THEN &quot;3 - Good&quot;&#13;&#10;ELSEIF [CreditRating] = 4 THEN &quot;4 - Medium&quot;&#13;&#10;ELSEIF [CreditRating] = 5 THEN &quot;5 - Low&quot;&#13;&#10;ELSEIF [CreditRating] = 6 THEN &quot;6 - Very Low&quot;&#13;&#10;ELSE &quot;7 - Lowest&quot;&#13;&#10;END' />
      </column>
      <column caption='Retention Call Label' datatype='string' name='[Calculation_0395596541620230]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [MadeCallToRetentionTeam] = 1 THEN &quot;Called Retention&quot;&#13;&#10;ELSE &quot;No Call Made&quot;&#13;&#10;END' />
      </column>
      <column caption='Revenue Segment' datatype='string' name='[Calculation_0395596541706247]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [MonthlyRevenue] &lt; 30 THEN &quot;1 - Low (&lt;$30)&quot;&#13;&#10;ELSEIF [MonthlyRevenue] &lt; 60 THEN &quot;2 - Medium ($30-60)&quot;&#13;&#10;ELSEIF [MonthlyRevenue] &lt; 100 THEN &quot;3 - High ($60-100)&quot;&#13;&#10;ELSE &quot;4 - Premium (&gt;$100)&quot;&#13;&#10;END' />
      </column>
      <column caption='Income Group Label' datatype='string' name='[Calculation_0395596603940872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [IncomeGroup] = 0 THEN &quot;0 - Lowest&quot;&#13;&#10;ELSEIF [IncomeGroup] = 1 THEN &quot;1 - Very Low&quot;&#13;&#10;ELSEIF [IncomeGroup] = 2 THEN &quot;2 - Low&quot;&#13;&#10;ELSEIF [IncomeGroup] = 3 THEN &quot;3 - Below Avg&quot;&#13;&#10;ELSEIF [IncomeGroup] = 4 THEN &quot;4 - Average&quot;&#13;&#10;ELSEIF [IncomeGroup] = 5 THEN &quot;5 - Above Avg&quot;&#13;&#10;ELSEIF [IncomeGroup] = 6 THEN &quot;6 - High&quot;&#13;&#10;ELSEIF [IncomeGroup] = 7 THEN &quot;7 - Very High&quot;&#13;&#10;ELSEIF [IncomeGroup] = 8 THEN &quot;8 - Wealthy&quot;&#13;&#10;ELSE &quot;9 - Highest&quot;&#13;&#10;END' />
      </column>
