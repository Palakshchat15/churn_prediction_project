      <aliases enabled='yes' />
      <column caption='Active Subs' datatype='integer' name='[ActiveSubs]' role='measure' type='quantitative' />
      <column caption='Adjustments To Credit Rating' datatype='integer' name='[AdjustmentsToCreditRating]' role='measure' type='quantitative' />
      <column caption='Avg Household Age' datatype='real' name='[AvgHouseholdAge]' role='measure' type='quantitative' />
      <column caption='Block Rate' datatype='real' name='[BlockRate]' role='measure' type='quantitative' />
      <column caption='Blocked Calls' datatype='real' name='[BlockedCalls]' role='measure' type='quantitative' />
      <column caption='Buys Via Mail Order' datatype='integer' name='[BuysViaMailOrder]' role='measure' type='quantitative' />
      <column caption='Churn Label' datatype='string' name='[Calculation_0628692666662913]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Churn] = 1 THEN &quot;Churned&quot; ELSE &quot;Retained&quot; END' />
      </column>
      <column caption='Churn Rate %' datatype='real' name='[Calculation_0628692666888194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Churn]) * 100' />
      </column>
      <column caption='Tenure Label' datatype='string' name='[Calculation_0628692666998787]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [TenureBucket] = 0 THEN &quot;0 - New (0-12m)&quot;&#13;&#10;ELSEIF [TenureBucket] = 1 THEN &quot;1 - Growing (12-24m)&quot;&#13;&#10;ELSEIF [TenureBucket] = 2 THEN &quot;2 - Established (24-48m)&quot;&#13;&#10;ELSE &quot;3 - Loyal (48m+)&quot;&#13;&#10;END' />
      </column>
      <column caption='Revenue Segment' datatype='string' name='[Calculation_0628692667088900]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [MonthlyRevenue] &lt; 30 THEN &quot;1 - Low (&lt;$30)&quot;&#13;&#10;ELSEIF [MonthlyRevenue] &lt; 60 THEN &quot;2 - Medium ($30-60)&quot;&#13;&#10;ELSEIF [MonthlyRevenue] &lt; 100 THEN &quot;3 - High ($60-100)&quot;&#13;&#10;ELSE &quot;4 - Premium (&gt;$100)&quot;&#13;&#10;END' />
      </column>
      <column caption='Credit Rating Label' datatype='string' name='[Calculation_0628692667162629]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CreditRating] = 1 THEN &quot;1 - Highest&quot;&#13;&#10;ELSEIF [CreditRating] = 2 THEN &quot;2 - High&quot;&#13;&#10;ELSEIF [CreditRating] = 3 THEN &quot;3 - Good&quot;&#13;&#10;ELSEIF [CreditRating] = 4 THEN &quot;4 - Medium&quot;&#13;&#10;ELSEIF [CreditRating] = 5 THEN &quot;5 - Low&quot;&#13;&#10;ELSEIF [CreditRating] = 6 THEN &quot;6 - Very Low&quot;&#13;&#10;ELSE &quot;7 - Lowest&quot;&#13;&#10;END' />
      </column>
      <column caption='Retention Call Label' datatype='string' name='[Calculation_0628692667256838]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [MadeCallToRetentionTeam] = 1 THEN &quot;Called Retention&quot;&#13;&#10;ELSE &quot;No Retention Call&quot;&#13;&#10;END' />
      </column>
      <column caption='Number of Records' datatype='integer' name='[Calculation_0628692668182535]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
